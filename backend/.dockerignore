# Python cache and virtual env
__pycache__/
*.pyc
venv/
.env
.env.*

# Dev-only requirements
dev-requirements.txt
dev-requirements.txtx  # just in case the typo file exists

# Ignore frontend and legacy files
frontend/

# Ignore stray requirements.txt files in subfolders
**/requirements.txt
!requirements.txt  # keep only the one you use