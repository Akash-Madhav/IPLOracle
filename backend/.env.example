# ==========================================
# IPL Oracle Backend Environment Variables
# ==========================================

# Pinecone Vector DB Configuration (Required)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws
INDEX_NAME=ipl-players

# Gemini AI API Configuration (Optional - for enhanced answer generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
ENV=development
PORT=8000
